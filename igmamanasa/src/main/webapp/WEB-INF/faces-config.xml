<?xml version='1.0' encoding='UTF-8'?>
<faces-config version="2.2"
              xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd">

    <managed-bean>
        <managed-bean-name>UserProfileFormBean</managed-bean-name>
        <managed-bean-class>com.isag.userprofile.UserProfileFormBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>

    <managed-bean>
        <managed-bean-name>loginBean</managed-bean-name>
        <managed-bean-class>com.isag.isag.LoginBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>userData</managed-bean-name>
        <managed-bean-class>com.isag.isag.UserData</managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean>
 
    <managed-bean>
        <managed-bean-name>companyListBean</managed-bean-name>
        <managed-bean-class>com.isag.company.CompanyListBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>companyFormBean</managed-bean-name>
        <managed-bean-class>com.isag.company.CompanyFormBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>RoleFormBean</managed-bean-name>
        <managed-bean-class>com.isag.roles.RoleFormBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>RoleListBean</managed-bean-name>
        <managed-bean-class>com.isag.roles.RoleListBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>userFormBean</managed-bean-name>
        <managed-bean-class>com.isag.user.UserFormBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    
    <managed-bean>
        <managed-bean-name>userListBean</managed-bean-name>
        <managed-bean-class>com.isag.user.UserListBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>privilegeListBean</managed-bean-name>
        <managed-bean-class>com.isag.privilege.PrivilegeListBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>currencyListBean</managed-bean-name>
        <managed-bean-class>com.isag.currency.CurrencyListBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>error</from-outcome>
            <to-view-id>/views/base/error.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>login</from-outcome>
            <to-view-id>/login.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>home</from-outcome>
            <to-view-id>/dashboard</to-view-id>
        </navigation-case>
    </navigation-rule>
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>exit</from-outcome>
            <to-view-id>dashboard</to-view-id>
        </navigation-case>
    </navigation-rule>
    <managed-bean>
        <managed-bean-name>generalSymbolBean</managed-bean-name>
        <managed-bean-class>com.isag.symbol.GeneralSymbolBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>branchListBean</managed-bean-name>
        <managed-bean-class>com.isag.branch.BranchListBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>userRoleFormBean</managed-bean-name>
        <managed-bean-class>com.isag.userrole.UserRoleFormBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>
    <managed-bean>
        <managed-bean-name>createAccountListBean</managed-bean-name>
        <managed-bean-class>com.isag.createaccount.CreateAccountListBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>

    
    <managed-bean>
        <managed-bean-name>dataDictionaryBean</managed-bean-name>
        <managed-bean-class>com.isag.datadictionary.DataDictionaryBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>

    <managed-bean>
        <managed-bean-name>reportsManagedBean</managed-bean-name>
        <managed-bean-class>com.isag.report.ReportsManagedBean</managed-bean-class>
        <managed-bean-scope>view</managed-bean-scope>
    </managed-bean>


    <converter id="companyConverter" >
        <converter-class>com.isag.converter.CompanyConverter</converter-class>
        <converter-id>companyConverter</converter-id>
    </converter>
    
    <factory>
        <exception-handler-factory>com.isag.common.GeneralErrorHandlerFactory</exception-handler-factory>
    </factory>
</faces-config>
